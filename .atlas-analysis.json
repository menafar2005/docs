  "keyFeatures": [
    "API Key authentication via query string",
    "Create, update, and search Contacts (persons and companies)",
    "Create, update, search, and change status of Deals",
    "Log and query Activities and Notes linked to contacts and deals",
    "Rich custom field filtering with AND/OR logic and 10+ condition types",
    "Pagination support for all list/search endpoints",
    "Lookup endpoints for Pipelines, Activity Types, Users, Products, Tags, and Loss Reasons",
    "Webhook support for real-time event notifications",
    "Integration plugins for WordPress/WooCommerce, VoIP, SMS panels, and accounting software"
  ],
  "publicApiSurface": [
    "POST /api/contact/save",
    "POST /api/contact/search",
    "POST /api/deal/save",
    "POST /api/deal/search",
    "POST /api/deal/changestatus",
    "POST /api/activity/save",
    "POST /api/activity/search",
    "GET  /api/activity/get",
    "POST /api/note/save",
    "GET  /api/pipeline/list",
    "GET  /api/activitytype/list",
    "GET  /api/user/list",
    "GET  /api/product/list",
    "POST /api/product/search",
    "GET  /api/customfield/list",
    "GET  /api/tag/list",
    "GET  /api/lossreason/list"
  ]
